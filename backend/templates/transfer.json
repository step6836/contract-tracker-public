{
  "type": "transfer",
  "label": "Transfer",
  "id_prefix": "TR",
  "start_label": "Transfer Request Form received",
  "notes": ["The transferee becomes the franchisee 1 month after signing (standard)."],
  "effective_after_signing_months": 1,
  "flags": [
    { "key": "transferee_is_existing", "label": "Transferee is an existing franchisee", "default": false }
  ],
  "steps": [
    { "id": "transfer_request_received", "label": "Transfer Request Form received", "owner": "Contracts", "hint": "Official start date.",
      "checklist": [ { "key": "mgmt_notified", "label": "VP notified" } ] },
    { "id": "contracts_eval", "label": "Contracts Evaluation (Transferor & Transferee)", "owner": "Contracts",
      "label_when": { "flag": "transferee_is_existing", "equals": false, "label": "Contracts Evaluation (Transferor)" },
      "checklist": [ { "key": "sent_to_legal", "label": "Sent to Legal", "owner": "Contracts" }, { "key": "proceed_confirmed", "label": "Confirmation to proceed", "owner": "Legal" } ] },
    { "id": "ops_acct_inspection", "label": "Operations & Accounting Team Inspection", "owner": "Operations & Accounting",
      "groups": [ { "key": "acct", "label": "Accounting Team Inspection", "short": "Accounting" },
                  { "key": "ops", "label": "Operations Team Inspection", "short": "Operations" } ],
      "checklist": [ { "key": "acct_requested", "label": "Requested", "owner": "Contracts", "group": "acct" },
                     { "key": "acct_satisfactory", "label": "Satisfactory", "owner": "Accounting", "group": "acct" },
                     { "key": "ops_requested", "label": "Requested", "owner": "Contracts", "group": "ops" },
                     { "key": "ops_satisfactory", "label": "Satisfactory", "owner": "Operations", "group": "ops" } ] },
    { "id": "mgmt_confirmation_1", "label": "VP Approval", "owner": "VP",
      "checklist": [ { "key": "vp_approved", "label": "VP approved" } ] },
    { "id": "app_request", "label": "Franchise Application Request", "owner": "Contracts",      "groups": [ { "key": "app", "label": "Franchise Application", "short": "Application" },
                  { "key": "bg", "label": "Background Check", "short": "Background check",
                    "only_when": { "flag": "transferee_is_existing", "equals": false } },
                  { "key": "quest", "label": "Questionnaire", "short": "Questionnaire",
                    "only_when": { "flag": "transferee_is_existing", "equals": false } } ],
      "checklist": [ { "key": "app_sent", "label": "Sent", "group": "app" },
                     { "key": "app_received", "label": "Received", "group": "app" },
                     { "key": "bg_requested", "label": "Requested", "group": "bg" },
                     { "key": "bg_received", "label": "Received", "group": "bg" },
                     { "key": "quest_sent", "label": "Sent", "group": "quest" },
                     { "key": "quest_received", "label": "Received", "group": "quest" } ] },
    { "id": "fdd_nda", "label": "FDD & NDA", "owner": "Contracts", "review_days": 14, "review_from": "fdd_sent",
      "hint": "14-day review period, counted from the day the FDD & NDA are sent.",
      "checklist": [ { "key": "fdd_sent", "label": "FDD & NDA sent" },
                     { "key": "fdd_received", "label": "Signed & received", "waiting": "signed FDD & NDA" } ] },
    { "id": "interview", "label": "Interview (Contracts Team)", "owner": "Contracts",
      "skip_when": { "flag": "transferee_is_existing", "equals": true, "reason": "Waived: existing franchisee" },
      "hint": "Can be scheduled as soon as the signed FDD & NDA are back; it doesn't wait for the review period.",
      "self_schedule": true, "schedule_label": "Interview", "scheduled_question": "Did the interview happen?",
      "checklist": [ { "key": "interview_held", "label": "Interview held", "from_schedule": true },
                     { "key": "summary_eval", "label": "Interview summary & evaluation" },
                     { "key": "eval_sent_vp", "label": "Evaluation sent to VP" },
                     { "key": "vp_confirmed", "label": "VP confirmed", "waiting": "VP confirmation" } ] },
    { "id": "fai", "label": "FAI", "owner": "Contracts",
      "hint": "Personal documents, entity documents and lease can be worked on at the same time.",
      "checklist": [ { "key": "fai_sent", "label": "FAI Sent" } ],
      "sections": [
        { "key": "personal", "label": "Personal Documents", "waiting": "personal documents", "start": "docs",
          "nodes": {
            "docs": { "type": "checks", "issues": true, "items": [
              { "key": "ids", "label": "2 forms of ID" },
              { "key": "residence", "label": "Proof of residence" },
              { "key": "bank", "label": "Bank statements" },
              { "key": "tax_return", "label": "Tax return" } ] } } },
        { "key": "entity", "label": "Entity Documents", "waiting": "entity documents", "start": "type",
          "nodes": {
            "type": { "type": "choice", "label": "Entity type", "options": [
              { "value": "llc", "label": "LLC", "next": "llc_docs" },
              { "value": "inc", "label": "INC", "next": "inc_docs" } ] },
            "llc_docs": { "type": "checks", "issues": true, "items": [
              { "key": "llc_articles", "label": "Articles of organization" },
              { "key": "llc_operating", "label": "Operating agreement" },
              { "key": "llc_ownership", "label": "Evidence of ownership and management" },
              { "key": "llc_irs", "label": "IRS letter" },
              { "key": "llc_tax", "label": "Corporate tax return" } ] },
            "inc_docs": { "type": "checks", "issues": true, "items": [
              { "key": "inc_articles", "label": "Articles of incorporation" },
              { "key": "inc_bylaws", "label": "Bylaws" },
              { "key": "inc_ownership", "label": "Evidence of ownership and management" },
              { "key": "inc_irs", "label": "IRS letter" },
              { "key": "inc_tax", "label": "Corporate tax return" } ] } } },
        { "key": "lease", "label": "Lease", "waiting": "lease", "start": "lease_steps",
          "nodes": {
            "lease_steps": { "type": "checks", "ordered": true, "done_text": "Lease approved", "items": [
              { "key": "lease_negotiation", "label": "Lease negotiation (Transferee, Transferor & Landlord)" },
              { "key": "lease_draft", "label": "Lease draft" },
              { "key": "lease_approved", "label": "Lease approved" } ] } } }
      ] },
    { "id": "fa_draft", "label": "Franchise Agreement Draft", "owner": "Contracts",
      "hint": "If Legal can't draft because of a problem with the FAI documents, use FAI correction to send the case back to FAI.",
      "checklist": [ { "key": "draft_requested", "label": "Draft requested", "owner": "Contracts", "group": "draft" },
                     { "key": "draft_received", "label": "Draft received", "owner": "Legal", "group": "draft", "status": "Legal drafting Franchise Agreement" },
                     { "key": "sent_transferor", "label": "Sent to Transferor", "owner": "Contracts", "group": "to_transferor", "after": "draft_received",
                       "waiting": "draft to be sent to the transferor", "hide_when_done": true },
                     { "key": "sent_transferee", "label": "Sent to Transferee", "owner": "Contracts", "group": "to_transferee", "after": "draft_received",
                       "waiting": "draft to be sent to the transferee", "hide_when_done": true } ],
      "correction": { "label": "FAI correction", "back_to": "fai", "after": "draft_requested", "before": "draft_received" } },
    { "id": "fa_negotiation", "label": "Franchise Agreement Negotiation / Review Period", "owner": "Contracts",
      "review_days": 7, "hint": "7-day review period, counted from the day the draft has been sent to both the transferor and the transferee. The signing can be scheduled for any day after it.",
      "started_by": { "step": "fa_draft", "items": ["sent_transferor", "sent_transferee"], "label": "Draft sent to transferor & transferee" },
      "schedules": "fa_signing", "schedule_label": "Signing" },
    { "id": "fa_signing", "label": "Franchise Agreement Signing Day", "owner": "Contracts", "milestone": "signing",
      "scheduled_question": "Did signing happen?" },
    { "id": "after_signing", "label": "After signing", "owner": "Contracts",
      "hint": "These can be done in any order. The opening date is the effective date of transfer shown at the top of the case (1 month after signing).",
      "checklist": [ { "key": "supplier_contacted", "label": "Contact supplier with new customer information", "group": "supplier" },
                     { "key": "opening_date", "label": "Complete opening date (effective date of transfer) on FA cover page", "group": "cover" },
                     { "key": "contact_master", "label": "Update Contact List & Master Chart", "group": "contact" } ] }
  ]
}
