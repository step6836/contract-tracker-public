{
  "type": "expansion",
  "label": "Expansion",
  "id_prefix": "E",
  "start_label": "Site Approval Form received",
  "notes": [
    "The franchisee has 6 months to secure a location if no lease is provided at signing.",
    "The lease can happen before or after signing, so it runs on its own track."
  ],
  "lease_deadline_months": 6,
  "flags": [],
  "steps": [
    { "id": "site_approval_received", "label": "Site Approval Form received", "owner": "Contracts", "hint": "Official start date.",
      "checklist": [ { "key": "mgmt_notified", "label": "Management notified" } ] },
    { "id": "contracts_eval", "label": "Contracts Team Evaluation", "owner": "Contracts",
      "hint": "Evaluate all related units for every principal.",
      "checklist": [ { "key": "sent_to_legal", "label": "Sent to Legal", "owner": "Contracts" }, { "key": "proceed_confirmed", "label": "Confirmation to proceed", "owner": "Legal" } ] },
    { "id": "ops_acct_inspection", "label": "Operations & Accounting Team Inspection", "owner": "Operations & Accounting", "stale_after_request_days": 30,
      "groups": [ { "key": "acct", "label": "Accounting Team Inspection", "short": "Accounting" },
                  { "key": "ops", "label": "Operations Team Inspection", "short": "Operations" } ],
      "checklist": [ { "key": "acct_requested", "label": "Requested", "owner": "Contracts", "group": "acct", "starts_clock": true },
                     { "key": "acct_satisfactory", "label": "Satisfactory", "owner": "Accounting", "group": "acct" },
                     { "key": "ops_requested", "label": "Requested", "owner": "Contracts", "group": "ops", "starts_clock": true },
                     { "key": "ops_satisfactory", "label": "Satisfactory", "owner": "Operations", "group": "ops" } ] },
    { "id": "mgmt_approval", "label": "Management Approval", "owner": "Management",
      "checklist": [ { "key": "mgmt_approved", "label": "Management approved" } ] },
    { "id": "app_request", "label": "Franchise Application Request", "owner": "Contracts",
      "hint": "Follow up with corrective actions, if applicable. Corrective actions move along at the same time, up to scheduling the signing date.",
      "checklist": [ { "key": "app_sent", "label": "Sent" },
                     { "key": "app_received", "label": "Received", "waiting": "franchise application" } ] },
    { "id": "fdd_nda", "label": "FDD & NDA", "owner": "Contracts", "review_days": 14, "review_from": "fdd_sent",
      "hint": "14-day review period, counted from the day the FDD & NDA are sent.",
      "checklist": [ { "key": "fdd_sent", "label": "FDD & NDA sent" },
                     { "key": "fdd_received", "label": "Signed & received", "waiting": "signed FDD & NDA" } ] },
    { "id": "ops_interview", "label": "Operations Team Interview", "owner": "Operations",
      "hint": "Capability to run multiple locations.",
      "self_schedule": true, "schedule_label": "Interview", "scheduled_question": "Did the interview happen?",
      "checklist": [ { "key": "interview_held", "label": "Interview held", "from_schedule": true } ] },
    { "id": "fai", "label": "FAI", "owner": "Contracts",
      "hint": "FAI documents need to be consistent with the Operations Team Interview. Personal and entity documents can be worked on at the same time.",
      "checklist": [ { "key": "fai_sent", "label": "FAI Sent" } ],
      "sections": [
        { "key": "personal", "label": "Personal Documents", "waiting": "personal documents", "start": "docs",
          "nodes": {
            "docs": { "type": "checks", "issues": true, "items": [
              { "key": "ids", "label": "2 forms of ID" },
              { "key": "residence", "label": "Proof of residence" },
              { "key": "bank", "label": "Bank statements" },
              { "key": "tax_return", "label": "Tax return" } ] } } },
        { "key": "entity", "label": "Entity Documents", "waiting": "entity documents", "start": "type",
          "nodes": {
            "type": { "type": "choice", "label": "Entity type", "options": [
              { "value": "llc", "label": "LLC", "next": "llc_docs" },
              { "value": "inc", "label": "INC", "next": "inc_docs" } ] },
            "llc_docs": { "type": "checks", "issues": true, "items": [
              { "key": "llc_articles", "label": "Articles of organization" },
              { "key": "llc_operating", "label": "Operating agreement" },
              { "key": "llc_ownership", "label": "Evidence of ownership and management" },
              { "key": "llc_irs", "label": "IRS letter" },
              { "key": "llc_tax", "label": "Corporate tax return" } ] },
            "inc_docs": { "type": "checks", "issues": true, "items": [
              { "key": "inc_articles", "label": "Articles of incorporation" },
              { "key": "inc_bylaws", "label": "Bylaws" },
              { "key": "inc_ownership", "label": "Evidence of ownership and management" },
              { "key": "inc_irs", "label": "IRS letter" },
              { "key": "inc_tax", "label": "Corporate tax return" } ] } } }
      ] },
    { "id": "fa_draft", "label": "Franchise Agreement Draft", "owner": "Contracts",
      "hint": "If Legal can't draft because of a problem with the FAI documents, use FAI correction to send the case back to FAI.",
      "checklist": [ { "key": "draft_requested", "label": "Draft requested", "owner": "Contracts" },
                     { "key": "draft_received", "label": "Draft received", "owner": "Legal", "status": "Legal drafting Franchise Agreement" },
                     { "key": "draft_sent", "label": "Draft sent for Franchisee review", "owner": "Contracts", "waiting": "draft to be sent for franchisee review", "show_after_previous": true, "hide_when_done": true } ],
      "correction": { "label": "FAI correction", "back_to": "fai", "after": "draft_requested", "before": "draft_received" } },
    { "id": "fa_negotiation", "label": "Franchise Agreement Negotiation / Review Period", "owner": "Contracts",
      "review_days": 7, "hint": "7-day franchisee review period, counted from the day the draft was sent. The signing can be scheduled for any day after it.",
      "started_by": { "step": "fa_draft", "item": "draft_sent", "label": "Draft sent to franchisee" },
      "schedules": "fa_signing", "schedule_label": "Signing" },
    { "id": "fa_signing", "label": "Franchise Agreement Signing Day", "owner": "Contracts", "milestone": "signing",
      "scheduled_question": "Did signing happen?" },
    { "id": "after_signing", "label": "After signing", "owner": "Contracts", "hint": "These can be done in any order.",
      "checklist": [ { "key": "supplier_contacted", "label": "Contact supplier with new customer information", "group": "supplier" },
                     { "key": "staff_reminder", "label": "Send calendar reminder to Operations to update Contracts Team on the opening date", "group": "staff" },
                     { "key": "opening_date", "label": "Amend FA cover page with opening date", "group": "cover" },
                     { "key": "contact_master", "label": "Update Contact List & Master Chart", "group": "contact" } ] }
  ],
  "side_track": {
    "label": "Lease",
    "note": "Runs on its own, before or after signing",
    "waiting_label": "Waiting on lease",
    "steps": [
      { "id": "lease_negotiation", "label": "Lease Negotiations (Landlord & Franchisee)", "owner": "Franchisee",
        "hint": "Follow up consistently on the status of the lease." },
      { "id": "lease_draft", "label": "Lease Draft", "owner": "Contracts" },
      { "id": "lease_approval", "label": "Lease Approval", "owner": "Contracts" }
    ]
  }
}
